# Copy to .env and fill in. All variables use the DOCSQA_ prefix and a
# double-underscore delimiter for nested settings.

# --- Datastores ---
DOCSQA_POSTGRES__DSN=postgresql+asyncpg://docsqa:docsqa@localhost:5432/docsqa
# Redis is only needed when DOCSQA_CACHE__BACKEND=redis (default is in-memory).
DOCSQA_REDIS__URL=redis://localhost:6379/0

# --- LLM provider (free tiers) ---
# provider/fallback_provider: gemini | groq | ollama | openrouter | none
DOCSQA_LLM__PROVIDER=openrouter
DOCSQA_LLM__FALLBACK_PROVIDER=none
# Google AI Studio key (https://aistudio.google.com/apikey)
DOCSQA_LLM__GEMINI_API_KEY=
DOCSQA_LLM__GEMINI_MODEL=gemini-2.5-flash
# Groq key (https://console.groq.com/keys)
DOCSQA_LLM__GROQ_API_KEY=
DOCSQA_LLM__GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter key (https://openrouter.ai/keys)
DOCSQA_LLM__OPENROUTER_API_KEY=
DOCSQA_LLM__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DOCSQA_LLM__OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Embeddings / reranking (local + free by default) ---
DOCSQA_EMBED__PROVIDER=fastembed
DOCSQA_EMBED__MODEL_NAME=BAAI/bge-small-en-v1.5
DOCSQA_RERANK__ENABLED=true

# --- Misc ---
DOCSQA_LOG_LEVEL=INFO
DOCSQA_LOG_JSON=false
DOCSQA_CACHE__BACKEND=memory
